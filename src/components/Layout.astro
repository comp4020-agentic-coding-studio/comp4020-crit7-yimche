---
// The page shell for the account pages (login, account, booking, tickets).
// index.astro and readme.astro keep their own <head> because they load extra
// things (Leaflet, the readme prose); these pages are plain HTML forms, so they
// share one small shell here rather than repeat the boilerplate four times.
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import "../styles.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
