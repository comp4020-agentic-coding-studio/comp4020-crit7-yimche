---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { currentUser } from "../lib/auth";
import { listFavouriteIds } from "../lib/accounts";
import { type CarParkWithLatest, listCarParks } from "../lib/db";
import "../styles.css";

const parks = listCarParks();

// Who's viewing, and which parks they've starred. Signed out, the set is empty
// and each card offers a sign-in link in place of the toggle. Favourites are
// private, so this is read per request rather than baked into the page.
const user = currentUser(Astro.cookies);
const favouriteIds = user ? listFavouriteIds(user.id) : new Set<number>();

// One place decides how a report reads, so the server render and the live
// client update agree. `null` is a real state — nobody has reported yet.
const LEVEL_TEXT: Record<string, string> = {
  plenty: "Plenty of spaces",
  some: "Filling up",
  full: "Full",
};
function availText(park: CarParkWithLatest): string {
  return park.latest ? LEVEL_TEXT[park.latest.level] : "No reports yet";
}
function availClass(park: CarParkWithLatest): string {
  return park.latest ? `avail avail-${park.latest.level}` : "avail avail-none";
}

// The map reads only what it needs from each row, as JSON embedded in the page.
const mapData = parks.map((p) => ({
  id: p.id,
  name: p.name,
  category: p.category,
  lat: p.lat,
  lng: p.lng,
  level: p.latest?.level ?? null,
  fav: favouriteIds.has(p.id),
}));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU campus parking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css"
      integrity="sha256-YU3qCpj/P06tdPBJGPax0bm6Q1wltfwjsho5TR4+TYc="
      crossorigin=""
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css"
      integrity="sha256-YSWCMtmNZNwqex4CEw1nQhvFub2lmU7vcCKP+XVwwXA="
      crossorigin=""
    />
  </head>
  <body>
    <SiteHeader />
    <main>
      <h1>ANU campus parking</h1>

      <div
        id="map"
        role="application"
        aria-label="Map of ANU campus parking areas"
      >
      </div>
      <noscript>
        <p class="notice">
          The interactive map needs JavaScript. The full directory below works
          without it.
        </p>
      </noscript>

      <h2 class="section">Parking areas</h2>
      {/* The filter bar is built by the client script as a progressive
          enhancement, so no-JS users never see controls that can't work; the
          full directory below is always rendered. */}
      <div id="filters" hidden></div>
      <ul class="parks">
        {
          parks.map((park) => (
            <li
              class="park"
              id={`park-${park.id}`}
              data-park-id={park.id}
              data-category={park.category}
              data-fav={favouriteIds.has(park.id) ? "1" : "0"}
              data-search={`${park.name} ${park.category} ${park.hours} ${park.rate} ${park.permit} ${park.fees} ${park.notes ?? ""}`.toLowerCase()}
            >
              <div class="park-head">
                <h3>{park.name}</h3>
                <span class="category">{park.category}</span>
                {
                  user ? (
                    <form class="fav" method="post" action="/api/favourites">
                      <input type="hidden" name="carParkId" value={park.id} />
                      <input
                        type="hidden"
                        name="on"
                        value={favouriteIds.has(park.id) ? "0" : "1"}
                      />
                      <button
                        type="submit"
                        class="fav-btn"
                        aria-pressed={favouriteIds.has(park.id) ? "true" : "false"}
                      >
                        <span class="fav-star" aria-hidden="true">
                          {favouriteIds.has(park.id) ? "★" : "☆"}
                        </span>
                        {favouriteIds.has(park.id) ? "Favourited" : "Favourite"}
                      </button>
                    </form>
                  ) : (
                    <a class="fav-signin" href="/login/">
                      <span aria-hidden="true">☆</span> Sign in to favourite
                    </a>
                  )
                }
              </div>
              <p
                class={availClass(park)}
                id={`avail-${park.id}`}
                aria-live="polite"
              >
                <span class="avail-label">Availability:</span> {availText(park)}
              </p>
              <dl class="facts">
                <dt>Hours</dt>
                <dd>{park.hours}</dd>
                <dt>Rate</dt>
                <dd>{park.rate}</dd>
                <dt>Permit</dt>
                <dd>{park.permit}</dd>
                <dt>Fees &amp; eligibility</dt>
                <dd>{park.fees}</dd>
                {park.capacity && (
                  <>
                    <dt>Approx. capacity</dt>
                    <dd>{park.capacity} spaces</dd>
                  </>
                )}
                {park.notes && (
                  <>
                    <dt>Good to know</dt>
                    <dd>{park.notes}</dd>
                  </>
                )}
              </dl>
              <form class="report" method="post" action="/api/reports">
                <input type="hidden" name="carParkId" value={park.id} />
                <label for={`level-${park.id}`}>Report how full it is</label>
                <select id={`level-${park.id}`} name="level" required>
                  <option value="plenty">Plenty of spaces</option>
                  <option value="some">Filling up</option>
                  <option value="full">Full</option>
                </select>
                <button>Report</button>
              </form>
            </li>
          ))
        }
      </ul>

      <p class="footnote">
        Rates follow ANU's published 2026 parking fees; every map position, and
        any capacity shown, comes from OpenStreetMap. The set is clipped to the
        campus by Clunies Ross Street, Barry Drive and Edinburgh Avenue, so lots
        across those roads are left out. Enforcement hours and permit types
        follow ANU's published parking guidance, but which permit type applies to
        a given lot is interpreted from OSM access tags for this prototype; see
        the note below before relying on any of it.
      </p>
    </main>
    <SiteFooter />

    <script
      type="application/json"
      id="parks-data"
      is:inline
      data-signed-in={user ? "1" : "0"}
      set:html={JSON.stringify(mapData)}></script>
    <script
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""
      is:inline></script>
    <script
      src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"
      integrity="sha256-Hk4dIpcqOSb0hZjgyvFOP+cEmDXUKKNE/tT542ZbNQg="
      crossorigin=""
      is:inline></script>
    <script>
      // The client half. Leaflet paints OpenStreetMap tiles and one marker per
      // car park; the SSE stream then keeps both the markers and the list cards
      // current as reports arrive from any tab. If Leaflet or the network is
      // unavailable, the server-rendered directory above still stands on its own.
      const LEVEL_TEXT: Record<string, string> = {
        plenty: "Plenty of spaces",
        some: "Filling up",
        full: "Full",
      };

      type ParkData = {
        id: number;
        name: string;
        category: string;
        lat: number;
        lng: number;
        level: string | null;
        fav: boolean;
      };

      // Leaflet is loaded from the CDN, so it's a runtime global rather than a
      // typed import; keep it loosely typed here.
      // deno-lint-ignore no-explicit-any
      const L = (window as unknown as { L?: any }).L;
      const dataEl = document.getElementById("parks-data");
      const parks: ParkData[] = dataEl ? JSON.parse(dataEl.textContent ?? "[]") : [];
      // Whether someone is signed in, so the popup can offer the star to them and
      // a sign-in link to everyone else, matching the card in the list below.
      const signedIn = dataEl?.dataset.signedIn === "1";
      const markers = new Map<number, any>();

      // The favourite toggle inside a marker popup: for a signed-in visitor, a
      // plain POST form (same endpoint and redirect as the card's star, so it
      // works without any popup-specific scripting); for everyone else, a link
      // to sign in. The escaped quotes keep the star's state honest on reload.
      function favControl(park: ParkData): string {
        if (!signedIn) {
          return `<a class="popup-fav-signin" href="/login/">&#9734; Sign in to favourite</a>`;
        }
        const on = park.fav ? "0" : "1";
        const label = park.fav ? "&#9733; Favourited" : "&#9734; Favourite";
        return (
          `<form class="popup-fav" method="post" action="/api/favourites">` +
          `<input type="hidden" name="carParkId" value="${park.id}">` +
          `<input type="hidden" name="on" value="${on}">` +
          `<button type="submit" aria-pressed="${park.fav ? "true" : "false"}">${label}</button>` +
          `</form>`
        );
      }

      function popupHtml(park: ParkData): string {
        const avail = park.level ? LEVEL_TEXT[park.level] : "No reports yet";
        return (
          `<strong>${park.name}</strong><br>${park.category}<br>${avail}<br>` +
          `<a href="#park-${park.id}">Details &amp; report</a><br>` +
          favControl(park)
        );
      }

      // deno-lint-ignore no-explicit-any
      let map: any = null;
      // A cluster group so that when the map is zoomed out, car parks close
      // together collapse into one marker badged with how many it stands for;
      // zooming in splits them back into individual markers. Falls back to a
      // plain layer group if the markercluster plugin didn't load, so the map
      // still shows every lot.
      // deno-lint-ignore no-explicit-any
      let cluster: any = null;
      if (L && document.getElementById("map") && parks.length > 0) {
        map = L.map("map");
        L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19,
          attribution:
            '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        }).addTo(map);

        cluster = L.markerClusterGroup
          ? L.markerClusterGroup({ showCoverageOnHover: false })
          : L.layerGroup();
        cluster.addTo(map);

        for (const park of parks) {
          const marker = L.marker([park.lat, park.lng]);
          marker.bindPopup(popupHtml(park));
          cluster.addLayer(marker);
          markers.set(park.id, marker);
        }

        // Keep marker popups in step with the live list.
        window.addEventListener("park-updated", (event) => {
          const detail = (event as CustomEvent<ParkData>).detail;
          const marker = markers.get(detail.id);
          if (marker) marker.setPopupContent(popupHtml(detail));
        });
      }

      // The map frames the campus by fitting all the markers. We nudge that
      // first fit one zoom level tighter so the page opens a little closer in
      // than a bare fit; this flag keeps the nudge to the initial paint, so
      // re-framing after a filter change still fits the filtered set exactly.
      let framedOnce = false;
      // deno-lint-ignore no-explicit-any
      function frame(bounds: any): void {
        if (!map || !bounds || !bounds.isValid()) return;
        if (framedOnce) {
          map.fitBounds(bounds, { padding: [30, 30], maxZoom: 18 });
          return;
        }
        const z = map.getBoundsZoom(bounds, false, L.point(30, 30));
        map.setView(bounds.getCenter(), Math.min(z + 1, 18));
        framedOnce = true;
      }

      // ---- Search & filter -------------------------------------------------
      // A progressive enhancement over the server-rendered directory: hide the
      // cards that don't match, and drop their markers from the map to match, so
      // the list and the map always show the same set. Built entirely here so a
      // no-JS visitor never sees a control that can't work.
      const cards = Array.from(
        document.querySelectorAll<HTMLLIElement>("li.park"),
      );
      const filters = document.getElementById("filters");
      if (filters && cards.length > 0) {
        const categories = Array.from(
          new Set(cards.map((c) => c.dataset.category ?? "")),
        )
          .filter(Boolean)
          .sort();

        // The favourites-only toggle is offered only to signed-in visitors:
        // signed out, every card's data-fav is "0", so the control would filter
        // to nothing. signedIn is read from the same data element as the map.
        const favField = signedIn
          ? `
          <div class="filter-field filter-field-check">
            <label for="filter-fav">
              <input id="filter-fav" type="checkbox" /> Favourites only
            </label>
          </div>`
          : "";

        filters.innerHTML = `
          <div class="filter-field">
            <label for="filter-search">Search parking</label>
            <input id="filter-search" type="search" autocomplete="off"
              placeholder="name, hall, permit, rate…" />
          </div>
          <div class="filter-field">
            <label for="filter-category">Category</label>
            <select id="filter-category">
              <option value="">All categories</option>
              ${categories
                .map((c) => `<option value="${c}">${c}</option>`)
                .join("")}
            </select>
          </div>${favField}
          <p id="filter-count" class="filter-count" aria-live="polite"></p>`;
        filters.hidden = false;

        const searchEl = document.getElementById(
          "filter-search",
        ) as HTMLInputElement;
        const categoryEl = document.getElementById(
          "filter-category",
        ) as HTMLSelectElement;
        // Null when signed out, since the control isn't rendered then.
        const favEl = document.getElementById(
          "filter-fav",
        ) as HTMLInputElement | null;
        const countEl = document.getElementById("filter-count") as HTMLElement;

        function applyFilter(): void {
          const q = searchEl.value.trim().toLowerCase();
          const cat = categoryEl.value;
          const favOnly = favEl?.checked ?? false;
          let shown = 0;
          // deno-lint-ignore no-explicit-any
          const visibleBounds = L ? L.latLngBounds([]) : null;

          for (const card of cards) {
            const okCat = !cat || card.dataset.category === cat;
            const okText = !q || (card.dataset.search ?? "").includes(q);
            const okFav = !favOnly || card.dataset.fav === "1";
            const visible = okCat && okText && okFav;
            card.hidden = !visible;

            const id = Number(card.dataset.parkId);
            const marker = markers.get(id);
            if (marker && cluster) {
              if (visible) {
                cluster.addLayer(marker);
                visibleBounds?.extend(marker.getLatLng());
              } else {
                cluster.removeLayer(marker);
              }
            }
            if (visible) shown++;
          }

          frame(visibleBounds);
          countEl.textContent =
            shown === cards.length
              ? `Showing all ${cards.length} parking areas`
              : `Showing ${shown} of ${cards.length} parking areas`;
        }

        searchEl.addEventListener("input", applyFilter);
        categoryEl.addEventListener("change", applyFilter);
        favEl?.addEventListener("change", applyFilter);
        applyFilter();
      } else if (map) {
        // No filter bar (e.g. no cards found): still frame all markers.
        frame(L.latLngBounds(parks.map((p) => [p.lat, p.lng])));
      }

      // The live channel: a report from any tab lands here and updates the
      // matching card's badge (and, via the event above, its map marker).
      const source = new EventSource("/api/events");
      source.addEventListener("message", (event) => {
        const report = JSON.parse(event.data) as {
          carParkId: number;
          level: string;
        };
        const badge = document.getElementById(`avail-${report.carParkId}`);
        if (badge) {
          badge.className = `avail avail-${report.level}`;
          badge.innerHTML = `<span class="avail-label">Availability:</span> ${LEVEL_TEXT[report.level]}`;
        }
        const park = parks.find((p) => p.id === report.carParkId);
        if (park) {
          park.level = report.level;
          window.dispatchEvent(new CustomEvent("park-updated", { detail: park }));
        }
      });
    </script>
  </body>
</html>
